# Model settings. Do not store real credentials in shared files.
AUTODIALECT_API_KEY="replace-with-your-api-key"
AUTODIALECT_MODEL="replace-with-your-model"
AUTODIALECT_BASE_URL="https://your-openai-compatible-endpoint.example/v1"

# Optional local inputs. CLI flags take precedence.
# AUTODIALECT_TESTCASE_FILE="/path/to/testcases.json"
# AUTODIALECT_ENGINE_SOURCE="/path/to/translation-engine"

# Optional runtime settings.
# AUTODIALECT_PYTHON_BIN="/path/to/python"
# AUTODIALECT_STAGE_TIMEOUT_S="3600"

# Optional runtime memory.
# LETTA_BASE_URL="http://localhost:8284"
# LETTA_AGENT_ID=""
# LETTA_AGENT_NAME="autodialect_memory_agent"
# LETTA_API_KEY=""
